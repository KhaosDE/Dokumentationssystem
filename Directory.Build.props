<Project>
  <!-- Gemeinsame Einstellungen für alle Projekte. -->
  <PropertyGroup>
    <!-- Versionsnummer des Programms; bei jeder ausgelieferten Änderung erhöhen (siehe STAND.md). -->
    <Version>0.33.19</Version>
    <!-- Build-Nummer = Laufnummer von GitHub Actions. 0 heißt: Entwicklerversion (kein Selbst-Update). -->
    <BuildNummer Condition="'$(BuildNummer)' == ''">0</BuildNummer>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Copyright>Demo – ausgedachte Daten</Copyright>
  </PropertyGroup>
</Project>
