<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kern ohne Oberfläche: Datenmodell, Speichern, Prüfregeln, Demo-Daten.
       Läuft und testet auch ohne Windows und ohne Fenster. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DokuLine.Kern</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite-Baustein von Microsoft (MIT). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- PDF-Formulare des HEB-Bogens ausfüllen. Nur 6.2.x: ab 6.5.0 steht PDFsharp unter AGPL-3.0. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp bringt sonst System.Security.Cryptography.Pkcs 8.0.1 mit bekannter Sicherheitslücke mit. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Die lesbare Demo-Datei aus dem Repository wird in die .exe eingebaut,
         damit nichts neben dem Programm liegen muss. -->
    <EmbeddedResource Include="..\..\daten\demo\bewohner.json" LogicalName="DokuLine.Kern.Demo.bewohner.json" />
    <EmbeddedResource Include="..\..\daten\demo\zimmer.json" LogicalName="DokuLine.Kern.Demo.zimmer.json" />
    <EmbeddedResource Include="..\..\daten\demo\aerztlich.json" LogicalName="DokuLine.Kern.Demo.aerztlich.json" />
    <EmbeddedResource Include="..\..\daten\demo\berichte.json" LogicalName="DokuLine.Kern.Demo.berichte.json" />
    <EmbeddedResource Include="..\..\daten\demo\aufgaben.json" LogicalName="DokuLine.Kern.Demo.aufgaben.json" />
    <EmbeddedResource Include="..\..\daten\demo\nachrichten.json" LogicalName="DokuLine.Kern.Demo.nachrichten.json" />
    <EmbeddedResource Include="..\..\daten\demo\medikamente.json" LogicalName="DokuLine.Kern.Demo.medikamente.json" />
    <EmbeddedResource Include="..\..\daten\demo\therapie.json" LogicalName="DokuLine.Kern.Demo.therapie.json" />
    <EmbeddedResource Include="..\..\daten\demo\wochenplan.json" LogicalName="DokuLine.Kern.Demo.wochenplan.json" />
    <EmbeddedResource Include="..\..\daten\demo\kalender.json" LogicalName="DokuLine.Kern.Demo.kalender.json" />
    <EmbeddedResource Include="..\..\daten\demo\biografie.json" LogicalName="DokuLine.Kern.Demo.biografie.json" />
