<Project Sdk="Microsoft.NET.Sdk">
  <!-- Modul „Ausgangsliste“ (zuschaltbar), übernommen aus der Ausgangsliste (docs/bruecke-ausgangsliste.md).
       Logik/: ohne Fenster, läuft auch in den Kern-Tests unter Linux (net10.0).
       Oberflaeche/: Seiten und Fenster, nur für Windows (net10.0-windows). -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <RootNamespace>Dokusystem.Modul.Ausgangsliste</RootNamespace>
    <!-- WFO1000 betrifft nur den Formular-Designer von Visual Studio; die Fenster hier sind von Hand gebaut. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Oberflaeche\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dokusystem.Kern\Dokusystem.Kern.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\Dokusystem.Bausteine\Dokusystem.Bausteine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\daten\demo\ausgangsliste.json" LogicalName="Dokusystem.Modul.Ausgangsliste.Demo.ausgangsliste.json" />
  </ItemGroup>
</Project>
