<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kern ohne Oberfläche: Datenmodell, Speichern, Prüfregeln, Demo-Daten.
       Läuft und testet auch ohne Windows und ohne Fenster. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Dokusystem.Kern</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite-Baustein von Microsoft (MIT). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Die lesbare Demo-Datei aus dem Repository wird in die .exe eingebaut,
         damit nichts neben dem Programm liegen muss. -->
    <EmbeddedResource Include="..\..\daten\demo\bewohner.json" LogicalName="Dokusystem.Kern.Demo.bewohner.json" />
    <EmbeddedResource Include="..\..\daten\demo\berichte.json" LogicalName="Dokusystem.Kern.Demo.berichte.json" />
    <EmbeddedResource Include="..\..\daten\demo\aufgaben.json" LogicalName="Dokusystem.Kern.Demo.aufgaben.json" />
    <EmbeddedResource Include="..\..\daten\demo\nachrichten.json" LogicalName="Dokusystem.Kern.Demo.nachrichten.json" />
    <EmbeddedResource Include="..\..\daten\demo\medikamente.json" LogicalName="Dokusystem.Kern.Demo.medikamente.json" />
    <EmbeddedResource Include="..\..\daten\demo\therapie.json" LogicalName="Dokusystem.Kern.Demo.therapie.json" />
    <EmbeddedResource Include="..\..\daten\demo\wochenplan.json" LogicalName="Dokusystem.Kern.Demo.wochenplan.json" />
    <EmbeddedResource Include="..\..\daten\demo\kalender.json" LogicalName="Dokusystem.Kern.Demo.kalender.json" />
    <EmbeddedResource Include="..\..\daten\demo\biografie.json" LogicalName="Dokusystem.Kern.Demo.biografie.json" />
    <EmbeddedResource Include="..\..\daten\demo\reflexion.json" LogicalName="Dokusystem.Kern.Demo.reflexion.json" />
    <EmbeddedResource Include="..\..\daten\uebergabe-woerter.txt" LogicalName="Dokusystem.Kern.uebergabe-woerter.txt" />
  </ItemGroup>
</Project>
